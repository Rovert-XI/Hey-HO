[sub_resource type="GDScript" id="GDScript_5x3xw"]
script/source = "class_name LectorEntrada
extends Node
## Responsabilidad: convertir las teclas en una dirección de largo 1 (o cero).


func leer_direccion() -> Vector3:
	var der := int(Input.is_key_pressed(KEY_D))
	var izq := int(Input.is_key_pressed(KEY_A))
	var atras := int(Input.is_key_pressed(KEY_S))
	var adelante := int(Input.is_key_pressed(KEY_W))
	return Vectores.normalizar(Vector3(der - izq, 0, atras - adelante))
"

[sub_resource type="GDScript" id="GDScript_nm0hh"]
script/source = "class_name Orientador
extends Node
## Responsabilidad: girar el Modelo (no el Jugador) hacia la dirección de movimiento.

@export var modelo: Node3D
@export var velocidad_giro := 10.0


func mirar(direccion: Vector3, dt: float) -> void:
	# Sin dirección no se toca el ángulo: el modelo se queda mirando hacia donde iba.
	if direccion == Vector3.ZERO:
		return
	modelo.rotation.y = lerp_angle(modelo.rotation.y, angulo_hacia(direccion), velocidad_giro * dt)


## En Godot \"adelante\" con ángulo 0 es -Z, y girar en +Y lleva -Z hacia -X:
## rotar (0, 0, -1) un ángulo θ da (-sen θ, 0, -cos θ), así que θ = atan2(-x, -z). En radianes.
static func angulo_hacia(d: Vector3) -> float:
	return atan2(-d.x, -d.z)
"

[sub_resource type="GDScript" id="GDScript_lxvb7"]
script/source = "class_name Motor
extends Node
## Responsabilidad: la velocidad (aceleración y fricción) y mover al nodo padre.

@export var velocidad_maxima := 5.0   # m/s
@export var aceleracion := 20.0       # m/s²
@export var friccion := 30.0          # m/s²

var velocidad := Vector3.ZERO


func avanzar(direccion: Vector3, dt: float) -> void:
	velocidad = siguiente_velocidad(velocidad, direccion, velocidad_maxima, aceleracion, friccion, dt)
	velocidad.x = 0.0
	(get_parent() as Node3D).position += velocidad * dt


## Función pura: no toca la escena, así que se puede probar con números.
static func siguiente_velocidad(actual: Vector3, direccion: Vector3, maxima: float,
		acel: float, fric: float, dt: float) -> Vector3:
	if direccion != Vector3.ZERO:
		return Vectores.acercar(actual, direccion * maxima, acel * dt)
	return Vectores.acercar(actual, Vector3.ZERO, fric * dt)
"

[sub_resource type="GDScript" id="GDScript_0hbpy"]
script/source = "class_name LuzJugador
extends OmniLight3D # o SpotLight3D si es una linterna
@export var rango := 5.0 # m: hasta dónde alumbra
@export var altura := 1.2 # m sobre los pies del jugador
func _ready() -> void:
	position = Vector3(0.0, altura, 0.0)
	omni_range = rango # en un SpotLight3D es spot_range
	omni_attenuation = 2.0 # la que se parece a 1/d²
	print(\"atenuación: \",atenuacion(1.0), \" \", atenuacion(2.0), \" \", atenuacion(4.0))
	
static func atenuacion(d: float, exponente: float = 2.0) -> float:
	return 1.0 / pow(maxf(d, 0.0001), exponente)
	
static func blinn_phong(normal: Vector3, hacia_luz: Vector3,
	hacia_ojo: Vector3, brillo: float) -> float:
	# TODO 1: normalizar los tres vectores (Vectores.normalizar)
	var n = Vectores.normalizar(normal)
	var l = Vectores.normalizar(hacia_luz)
	var v = Vectores.normalizar(hacia_ojo)
	# TODO 2: el vector medio h = normalizar(hacia_luz + hacia_ojo)
	var h = Vectores.normalizar(l + v)
	# TODO 3: max(0, n · h) elevado a brillo (pow)
	var n_dot_h = maxf(0.0, n.dot(h))
	return pow(n_dot_h, brillo)
"

